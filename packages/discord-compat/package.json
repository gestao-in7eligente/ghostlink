{
  "name": "@ghostlink/discord-compat",
  "version": "0.6.0",
  "private": true,
  "description": "Run a discord.js v14 bot on a GhostLink server: change the import and the token.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ghostlink/shared": "*",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2"
  }
}
