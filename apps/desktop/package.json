{
  "name": "@ghostlink/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "GhostLink desktop app (Electron)",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "build": "electron-vite build",
    "dev": "node ../../scripts/run-electron.mjs electron-vite dev",
    "start": "node ../../scripts/run-electron.mjs electron .",
    "smoke:dev": "node ../../scripts/run-electron.mjs --smoke electron .",
    "dist": "npm run build && electron-builder --config electron-builder.yml --publish never"
  },
  "dependencies": {
    "@peculiar/x509": "2.1.0",
    "reflect-metadata": "0.2.2",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@ghostlink/server": "*",
    "@ghostlink/shared": "*",
    "@tanstack/react-virtual": "3.14.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "author": "GhostLink contributors"
}
